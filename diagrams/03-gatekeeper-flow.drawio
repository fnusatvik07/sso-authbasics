<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Gatekeeper Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="The Gatekeeper: get_current_user()" style="text;html=1;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="This function runs BEFORE every protected route. If any check fails, the route never executes." style="text;html=1;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="55" width="540" height="20" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="Request arrives&#xa;at /chat" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Step 1: Read cookie -->
        <mxCell id="p1" value="Read session_token&#xa;from cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="190" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_start_p1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="start" target="p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision 1: Cookie exists? -->
        <mxCell id="d1" value="Cookie&#xa;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="280" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_p1_d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="p1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- No cookie -> 401 -->
        <mxCell id="err1" value="401&#xa;Not logged in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="295" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_err1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="err1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err1_ex" value="Example: User never logged in,&#xa;or cleared their cookies" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="220" height="30" as="geometry" />
        </mxCell>

        <!-- Step 2: Lookup in DB -->
        <mxCell id="p2" value="Look up token in&#xa;sessions table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="400" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d1_p2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;fontColor=#82b366;fontSize=11;" edge="1" parent="1" source="d1" target="p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision 2: Token found? -->
        <mxCell id="d2" value="Token&#xa;found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="490" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_p2_d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="p2" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- No token -> 401 -->
        <mxCell id="err2" value="401&#xa;Invalid session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="505" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_err2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2" target="err2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err2_ex" value="Example: User tampered with cookie,&#xa;or session was already deleted" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- Decision 3: Expired? -->
        <mxCell id="d3" value="Session&#xa;expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="610" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_d2_d3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;fontColor=#82b366;fontSize=11;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Expired -> 401 -->
        <mxCell id="err3" value="401&#xa;Session expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="625" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_err3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="err3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err3_ex" value="Session older than 24 hours.&#xa;Also deletes the stale session row." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="90" y="680" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- Step 3: Get user -->
        <mxCell id="p3" value="Get user from&#xa;users table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="730" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d3_p3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;fontColor=#82b366;fontSize=11;" edge="1" parent="1" source="d3" target="p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision 4: User active? -->
        <mxCell id="d4" value="User&#xa;active?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="820" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_p3_d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="p3" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Not active -> 403 -->
        <mxCell id="err4" value="403&#xa;Deactivated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="835" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d4_err4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;fontColor=#b85450;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="err4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="err4_ex" value="Admin or SCIM deactivated the account.&#xa;Even with a valid session, blocked." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="890" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- SUCCESS: Return user -->
        <mxCell id="success" value="All checks passed!&#xa;Return user object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="940" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_d4_success" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;fontColor=#82b366;fontSize=11;" edge="1" parent="1" source="d4" target="success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- chat() executes -->
        <mxCell id="chat_fn" value="chat() executes&#xa;Agent answers the question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="1020" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e_success_chat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="success" target="chat_fn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg_title" value="Example paths:" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="870" y="100" width="120" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg1_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="870" y="135" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value='No cookie: fails at Step 1' style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#b85450;align=left;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg2_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="870" y="165" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value='Fake cookie: fails at Step 2' style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="890" y="160" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="leg3_dot" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="870" y="195" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value='Valid cookie: passes all, chat() runs' style="text;html=1;fontSize=11;fillColor=none;strokeColor=none;fontColor=#82b366;align=left;" vertex="1" parent="1">
          <mxGeometry x="890" y="190" width="230" height="20" as="geometry" />
        </mxCell>

        <!-- Legend box -->
        <mxCell id="leg_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="270" height="130" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
