<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Google OAuth Sequence">
    <mxGraphModel dx="1100" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ ACTOR BOXES ============ -->

        <!-- Your Browser -->
        <mxCell id="ab" value="Your Browser&#xa;User's device" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;size=55;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="30" width="160" height="1480" as="geometry" />
        </mxCell>

        <!-- AgentFlow -->
        <mxCell id="as" value="AgentFlow&#xa;localhost:8000" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;size=55;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="160" height="1480" as="geometry" />
        </mxCell>

        <!-- Google OAuth -->
        <mxCell id="ag" value="Google OAuth&#xa;accounts.google.com" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;size=55;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="30" width="180" height="1480" as="geometry" />
        </mxCell>

        <!-- ============ STEP 1: Browser -> AgentFlow ============ -->

        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="GET /auth/google/login" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;fontStyle=1;strokeWidth=2;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ab" target="as">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="155" as="sourcePoint" />
            <mxPoint x="500" y="155" as="targetPoint" />
            <Array as="points">
              <mxPoint x="340" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="t1" value="User clicks &quot;Login with Google&quot; button" style="text;html=1;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="170" y="165" width="330" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STEP 2: AgentFlow -> Google ============ -->

        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="302 Redirect to Google" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;fontStyle=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="245" as="sourcePoint" />
            <mxPoint x="840" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t2" value="Sends: client_id, redirect_uri, scope=openid email profile, state=random_csrf" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="255" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STEP 3: Browser -> Google ============ -->

        <mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="User enters Google email &amp; password" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;fontStyle=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="335" as="sourcePoint" />
            <mxPoint x="840" y="335" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t3" value="Password goes directly to Google. AgentFlow never sees it." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="345" width="600" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STEP 4: Google -> AgentFlow ============ -->

        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="302 Redirect to /auth/callback?code=4/0Aean...&amp;state=csrf" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;fontStyle=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="425" as="sourcePoint" />
            <mxPoint x="500" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t4" value="Authorization code is one-time use, expires in 5 min. Useless without client_secret." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#888888;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="435" width="440" height="20" as="geometry" />
        </mxCell>

        <!-- ============ SERVER-TO-SERVER BAND ============ -->

        <mxCell id="s2s_band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4ff;strokeColor=#b0c4f4;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="500" height="380" as="geometry" />
        </mxCell>

        <mxCell id="s2s_label" value="SERVER-TO-SERVER&#xa;Browser is not involved in these steps" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#6690e6;align=right;" vertex="1" parent="1">
          <mxGeometry x="580" y="495" width="290" height="35" as="geometry" />
        </mxCell>

        <!-- ============ STEP 5: AgentFlow -> Google (exchange code) ============ -->

        <mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="555" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e5a" value="POST /token" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;fontStyle=1;strokeWidth=2;strokeColor=#2563eb;fontColor=#2563eb;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="570" as="sourcePoint" />
            <mxPoint x="840" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t5a" value="Sends: code + client_id + client_secret (from .env, never in browser)" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#6690e6;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="580" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- Return: tokens -->
        <mxCell id="e5b" value="Returns: access_token + id_token" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=11;fontStyle=2;strokeWidth=2;strokeColor=#2563eb;fontColor=#2563eb;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="630" as="sourcePoint" />
            <mxPoint x="500" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t5b" value="Tokens stay on server. Never sent to the browser." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#6690e6;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="640" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STEP 6: AgentFlow -> Google (userinfo) ============ -->

        <mxCell id="n6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#2563eb;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="700" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e6a" value="GET /userinfo (Bearer access_token)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;fontSize=12;fontStyle=1;strokeWidth=2;strokeColor=#2563eb;fontColor=#2563eb;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="715" as="sourcePoint" />
            <mxPoint x="840" y="715" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t6a" value="Sends: access_token in Authorization header" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#6690e6;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="725" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- Return: user info -->
        <mxCell id="e6b" value='Returns: {"email":"priya@gmail.com", "name":"Priya Sharma", "email_verified":true}' style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;fontSize=10;fontStyle=2;strokeWidth=2;strokeColor=#2563eb;fontColor=#2563eb;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="840" y="775" as="sourcePoint" />
            <mxPoint x="500" y="775" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t6b" value="Email is verified by Google. No one typed it. No one can fake it." style="text;html=1;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#16a34a;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="785" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- ============ STEP 7: AgentFlow -> Browser (session + cookie) ============ -->

        <mxCell id="n7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="30" y="930" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="302 Redirect + Set-Cookie: session_token=7f8e9a..." style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=12;fontStyle=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="945" as="sourcePoint" />
            <mxPoint x="170" y="945" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="t7" value="Session created (identical to Phase 1). Cookie set. User is logged in." style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#16a34a;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="955" width="430" height="20" as="geometry" />
        </mxCell>

        <!-- ============ BOTTOM NOTE ============ -->

        <mxCell id="bottom" value="From this point on: identical to Phase 1.&#xa;Cookie on every request, session lookup in database, get_current_user() gatekeeper, logout.&#xa;The only thing that changed was how the user's email was verified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=2;align=center;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="1020" width="600" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
