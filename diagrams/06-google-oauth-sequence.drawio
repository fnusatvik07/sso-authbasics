<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Google OAuth Sequence">
    <mxGraphModel dx="1100" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ ACTOR BOXES ============ -->
        <mxCell id="box_b" value="Your Browser&#xa;User's device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box_s" value="AgentFlow&#xa;localhost:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="box_g" value="Google OAuth&#xa;accounts.google.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="760" y="30" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- ============ LIFELINES (manual dashed) ============ -->
        <mxCell id="ll_b" value="" style="line;strokeWidth=1;strokeColor=#6c8ebf;dashed=1;dashPattern=8 4;direction=south;" vertex="1" parent="1">
          <mxGeometry x="159" y="85" width="1" height="1350" as="geometry" />
        </mxCell>
        <mxCell id="ll_s" value="" style="line;strokeWidth=1;strokeColor=#82b366;dashed=1;dashPattern=8 4;direction=south;" vertex="1" parent="1">
          <mxGeometry x="499" y="85" width="1" height="1350" as="geometry" />
        </mxCell>
        <mxCell id="ll_g" value="" style="line;strokeWidth=1;strokeColor=#d6b656;dashed=1;dashPattern=8 4;direction=south;" vertex="1" parent="1">
          <mxGeometry x="849" y="85" width="1" height="1350" as="geometry" />
        </mxCell>

        <!-- ============ STEP 1 ============ -->
        <mxCell id="n1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="130" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="145" as="sourcePoint" />
            <mxPoint x="494" y="145" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l1" value="GET /auth/google/login" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="195" y="122" width="270" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="User clicks &quot;Login with Google&quot; button" style="text;html=1;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#777777;align=center;" vertex="1" parent="1">
          <mxGeometry x="195" y="152" width="270" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 2 ============ -->
        <mxCell id="n2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="218" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="233" as="sourcePoint" />
            <mxPoint x="844" y="233" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l2" value="302 Redirect to Google" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="535" y="210" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Sends: client_id, redirect_uri, scope, state" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#777777;align=center;" vertex="1" parent="1">
          <mxGeometry x="535" y="240" width="280" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 3 ============ -->
        <mxCell id="n3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="306" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="321" as="sourcePoint" />
            <mxPoint x="844" y="321" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l3" value="User enters Google email and password" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="298" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Password goes directly to Google. AgentFlow never sees it." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#777777;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="328" width="400" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 4 ============ -->
        <mxCell id="n4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="394" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="844" y="409" as="sourcePoint" />
            <mxPoint x="505" y="409" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l4" value="302 Redirect: /auth/callback?code=4/0Aean...&amp;state=csrf" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="386" width="310" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Code is one-time use, expires in 5 min. Useless without client_secret." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#777777;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="416" width="340" height="18" as="geometry" />
        </mxCell>

        <!-- ============ S2S BAND ============ -->
        <mxCell id="band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#a8c0f0;strokeWidth=1.5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="475" width="490" height="380" as="geometry" />
        </mxCell>
        <mxCell id="band_label" value="SERVER-TO-SERVER" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="480" width="200" height="22" as="geometry" />
        </mxCell>
        <mxCell id="band_sub" value="Browser is not involved in steps 5 and 6" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#7a9ce0;align=center;" vertex="1" parent="1">
          <mxGeometry x="510" y="500" width="260" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 5 ============ -->
        <mxCell id="n5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="540" width="32" height="32" as="geometry" />
        </mxCell>

        <!-- Request arrow -->
        <mxCell id="e5a" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="555" as="sourcePoint" />
            <mxPoint x="844" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l5a" value="POST /token" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="532" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d5a" value="Sends: code + client_id + client_secret (from .env)" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#5b8fe8;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="562" width="300" height="18" as="geometry" />
        </mxCell>

        <!-- Response arrow -->
        <mxCell id="e5b" value="" style="endArrow=open;endFill=0;html=1;strokeWidth=2;strokeColor=#2563eb;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="844" y="620" as="sourcePoint" />
            <mxPoint x="505" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l5b" value="Returns: access_token + id_token" style="text;html=1;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="597" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d5b" value="Tokens stay on server. Never sent to browser." style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#5b8fe8;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="627" width="280" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 6 ============ -->
        <mxCell id="n6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="680" width="32" height="32" as="geometry" />
        </mxCell>

        <!-- Request arrow -->
        <mxCell id="e6a" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#2563eb;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="695" as="sourcePoint" />
            <mxPoint x="844" y="695" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l6a" value="GET /userinfo (Bearer token)" style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="672" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d6a" value="Sends: access_token in Authorization header" style="text;html=1;fontSize=10;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#5b8fe8;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="702" width="300" height="18" as="geometry" />
        </mxCell>

        <!-- Response arrow -->
        <mxCell id="e6b" value="" style="endArrow=open;endFill=0;html=1;strokeWidth=2;strokeColor=#2563eb;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="844" y="760" as="sourcePoint" />
            <mxPoint x="505" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l6b" value='Returns: {email, name, picture, email_verified: true}' style="text;html=1;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;fontColor=#2563eb;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="737" width="310" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d6b" value="Email is verified by Google. No one typed it. No one can fake it." style="text;html=1;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#16a34a;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="767" width="310" height="18" as="geometry" />
        </mxCell>

        <!-- ============ STEP 7 ============ -->
        <mxCell id="n7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="25" y="905" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="494" y="920" as="sourcePoint" />
            <mxPoint x="165" y="920" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="l7" value="302 Redirect + Set-Cookie: session_token=7f8e..." style="text;html=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="170" y="897" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="Session created (identical to Phase 1). Cookie set. User is logged in." style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#16a34a;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="928" width="370" height="18" as="geometry" />
        </mxCell>

        <!-- ============ BOTTOM NOTE ============ -->
        <mxCell id="bottom_note" value="From this point on: identical to Phase 1&#xa;Cookie on every request | Session lookup in database | get_current_user() gatekeeper | Logout&#xa;The only thing that changed was how the user's email was verified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=2;align=center;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="990" width="500" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
