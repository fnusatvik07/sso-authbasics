<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Login Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="What Happens When You Login" style="text;html=1;fontSize=22;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#333333;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Request arrives -->
        <mxCell id="step1_label" value="Step 1" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="POST /auth/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step1_data" value='{&quot;email&quot;: &quot;priya@test.com&quot;}' style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="220" height="30" as="geometry" />
        </mxCell>

        <!-- Arrow 1->2 -->
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2: Find user -->
        <mxCell id="step2_label" value="Step 2" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="Find user in database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step2_sql" value="SELECT * FROM users&#xa;WHERE email = 'priya@test.com'&#xa;Result: id=1, name='Priya Sharma'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="170" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 2->3 -->
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Generate token -->
        <mxCell id="step3_label" value="Step 3" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="90" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="Generate random token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step3_code" value="token = secrets.token_hex(32)&#xa;= &quot;a6f3b9c2d8e4f1a0b7...&quot;&#xa;(64 hex chars, unguessable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="700" y="170" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 3->4 (down) -->
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step3_code" target="step4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Save session -->
        <mxCell id="step4_label" value="Step 4" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="290" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="Save session to database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="310" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step4_sql" value="INSERT INTO sessions&#xa;  (session_token, user_id, expires_at)&#xa;VALUES&#xa;  ('a6f3b9c2d8...', 1, '2026-04-25')" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="370" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow 4->5 (down) -->
        <mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step4_sql" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: Set cookie -->
        <mxCell id="step5_label" value="Step 5" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="350" y="470" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="Set cookie on HTTP response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="490" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step5_header" value="HTTP Response Header:&#xa;Set-Cookie: session_token=a6f3b9c2d8...;&#xa;  HttpOnly; SameSite=Lax; Max-Age=86400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="550" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Security flags note -->
        <mxCell id="flags_note" value="Cookie Security Flags" style="text;html=1;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="750" y="470" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="flag1" value="HttpOnly = JavaScript can't read it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="500" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flag2" value="SameSite=Lax = Only same-site requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="540" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flag3" value="Max-Age=86400 = Expires in 24 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="580" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- Arrow flags -->
        <mxCell id="ef" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step5" target="flag1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow 5->6 (down) -->
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="515" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 6: Browser stores -->
        <mxCell id="step6_label" value="Step 6" style="text;html=1;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="Browser stores the cookie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="step6_note" value="From now on, EVERY request to&#xa;localhost:8000 automatically includes:&#xa;Cookie: session_token=a6f3b9c2d8..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="260" height="55" as="geometry" />
        </mxCell>

        <!-- Summary box -->
        <mxCell id="summary" value="Summary: Login creates a LINK between&#xa;the browser (cookie) and the database (session row).&#xa;The token value is the same in both places." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="680" width="380" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
